---
interface Props {
  href?: string;
  title: string;
  tagline: string;
  stack: string[];
  period: string;
}

const { href, title, tagline, stack, period } = Astro.props;
---
<article class="row">
  <div class="row-head">
    <h3 class="row-title">
      {href ? <a href={href}>{title}</a> : title}
    </h3>
    <span class="row-meta">{period}</span>
  </div>
  <p class="row-tagline">{tagline}</p>
  <ul class="stack">
    {stack.map((item) => <li>{item}</li>)}
  </ul>
</article>
