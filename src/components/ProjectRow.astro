---
interface Props {
  href?: string;
  title: string;
  tagline: string;
  stack: string[];
  period: string;
  /** Checked figures, read by `npm run stats` rather than written. */
  proof?: string[];
}

const { href, title, tagline, stack, period, proof = [] } = Astro.props;
---
<article class="row">
  <div class="row-head">
    <h3 class="row-title">
      {href ? <a href={href}>{title}</a> : title}
    </h3>
    <span class="row-meta">{period}</span>
  </div>
  <p class="row-tagline">{tagline}</p>
  <ul class="stack">
    {stack.map((item) => <li>{item}</li>)}
  </ul>
  {proof.length > 0 && (
    <ul class="proof" aria-label="Checked against the source">
      {proof.map((item) => <li>{item}</li>)}
    </ul>
  )}
</article>
