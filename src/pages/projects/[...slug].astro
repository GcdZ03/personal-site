---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { hasDetailPage } from '@/lib/projects';

export const getStaticPaths = (async () => {
  const entries = await getCollection('projects');
  return entries
    .filter((entry) => hasDetailPage(entry.data.tier))
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

/** Frontmatter keys are not link text. Three links, three labels, no abstraction. */
const LINK_LABELS: Record<string, string> = {
  repo: 'Source on GitHub',
  download: 'Download',
  demo: 'Live demo',
};

const { entry } = Astro.props;
const { Content } = await render(entry);
const links = (Object.entries(entry.data.links) as Array<[string, string]>).map(
  ([key, href]) => ({ label: LINK_LABELS[key] ?? key, href }),
);
---
<BaseLayout title={`${entry.data.title} — Gerald Chang`} description={entry.data.tagline}>
  <article>
    <h1 class="text-h1">{entry.data.title}</h1>
    <p class="mt-4 max-w-[34rem] text-lead text-muted">{entry.data.tagline}</p>

    <dl class="facts mt-10">
      <dt>Role</dt><dd>{entry.data.role}</dd>
      <dt>Period</dt><dd>{entry.data.period}</dd>
      <dt>Stack</dt><dd>{entry.data.stack.join(', ')}</dd>
    </dl>

    {links.length > 0 && (
      <p class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-ui">
        {links.map((link) => <a class="link" href={link.href}>{link.label}</a>)}
      </p>
    )}

    <div class="prose mt-section max-w-none"><Content /></div>
  </article>
</BaseLayout>
