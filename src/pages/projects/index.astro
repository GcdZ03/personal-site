---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectRow from '@/components/ProjectRow.astro';
import { sortProjects, toProjectListings, projectHref } from '@/lib/projects';

const entries = await getCollection('projects');
const projects = sortProjects(toProjectListings(entries));

const listed = projects.filter((project) => project.tier !== 'archive');
const archived = projects.filter((project) => project.tier === 'archive');
---
<BaseLayout title="Projects — Gerald Chang" description="Side projects and things built.">
  <h1 class="text-h1">Projects</h1>

  <section class="mt-section">
    <h2 class="eyebrow">Selected work</h2>
    <div class="rows">
      {listed.map((project) => (
        <ProjectRow
          href={projectHref(project)}
          title={project.data.title}
          tagline={project.data.tagline}
          stack={project.data.stack}
          period={project.data.period}
        />
      ))}
    </div>
  </section>

  {archived.length > 0 && (
    <section class="mt-section">
      <h2 class="eyebrow">Also built</h2>
      <ul class="mt-6 space-y-2 text-ui">
        {archived.map((project) => (
          <li>
            {projectHref(project)
              ? <a class="link-quiet" href={projectHref(project)}>{project.data.title}</a>
              : <span class="text-muted">{project.data.title}</span>}
            <span class="text-faint"> — {project.data.tagline}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
