---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { experience, skills } from '@/data/experience';
---
<BaseLayout title="About — Gerald Chang" description="Experience, skills and background.">
  <h1 class="text-h1">About</h1>
  <p class="mt-6 max-w-[34rem] text-lead text-muted">
    Developer. I build macOS tools that respect the machine they run on.
  </p>

  <section class="mt-block">
    <h2 class="eyebrow">Experience</h2>
    <div class="rows">
      {experience.map((role) => (
        <article class="row">
          <div class="row-head">
            <h3 class="row-title">{role.title}, {role.organisation}</h3>
            <span class="row-meta">{role.period}</span>
          </div>
          <p class="row-tagline">{role.summary}</p>
          <ul class="mt-3 space-y-1.5 text-ui text-muted">
            {role.highlights.map((item) => (
              <li class="relative pl-5 before:absolute before:left-0 before:top-[0.7em] before:h-px before:w-2.5 before:bg-rule-strong">
                {item}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="mt-section">
    <h2 class="eyebrow">Skills</h2>
    <dl class="facts mt-6">
      {skills.map((group) => (
        <>
          <dt>{group.label}</dt>
          <dd>{group.items.join(', ')}</dd>
        </>
      ))}
    </dl>
  </section>
</BaseLayout>
