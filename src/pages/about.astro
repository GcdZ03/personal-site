---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { experience, skills } from '@/data/experience';
---
<BaseLayout title="About — Gerald Chang" description="Software engineer at Enroute Tech, building developer tools and a macOS app on the side.">
  <h1 class="text-h1">About</h1>
  <div class="mt-6 max-w-[34rem] space-y-4 text-lead text-muted">
    <p>
      I'm a software engineer at Enroute Tech, working on a fleet and logistics
      platform: a PHP backend and two Flutter apps, where every change goes
      through human review.
    </p>
    <p>
      Outside work I build tools I use myself. What connects them is that each
      one has to back up its claims. CreativeNotch holds its no-polling rule to
      a grep of its own source. pr-decision-log was redesigned after I measured
      my own agent sessions and found the reasoning it set out to capture wasn't
      there.
    </p>
  </div>

  <section class="mt-block">
    <h2 class="eyebrow">Experience</h2>
    <div class="rows">
      {experience.map((role) => (
        <article class="row">
          <div class="row-head">
            <h3 class="row-title">{role.title}, {role.organisation}</h3>
            <span class="row-meta">{role.period}</span>
          </div>
          <p class="row-tagline">{role.summary}</p>
          <ul class="mt-3 space-y-1.5 text-ui text-muted">
            {role.highlights.map((item) => (
              <li class="relative pl-5 before:absolute before:left-0 before:top-[0.7em] before:h-px before:w-2.5 before:bg-rule-strong">
                {item}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="mt-section">
    <h2 class="eyebrow">Skills</h2>
    <dl class="facts mt-6">
      {skills.map((group) => (
        <>
          <dt>{group.label}</dt>
          <dd>{group.items.join(', ')}</dd>
        </>
      ))}
    </dl>
  </section>
</BaseLayout>
