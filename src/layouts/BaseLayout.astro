---
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Writing' },
  { href: '/about', label: 'About' },
];

// The notch marks the section you are in, so a case study keeps /projects lit.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body class="bg-canvas text-ink antialiased">
    <div class="flex min-h-screen flex-col">
      <header class="bar">
        <div class="mx-auto w-full max-w-page px-gutter sm:px-8">
          <nav class="bar-nav" aria-label="Primary">
            {nav.map((item) => (
              <a
                class="bar-link"
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      </header>

      <main class="mx-auto w-full max-w-page flex-1 px-gutter pt-section pb-block sm:px-8">
        <slot />
      </main>

      <footer class="mt-auto border-t border-rule">
        <div class="mx-auto w-full max-w-page px-gutter py-8 font-mono text-meta sm:px-8">
          <a class="link-quiet" href="https://github.com/GcdZ03">GitHub</a>
        </div>
      </footer>
    </div>
  </body>
</html>
