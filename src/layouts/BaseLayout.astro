---
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Social cards for a post are articles; everything else is a page. */
  ogType?: 'website' | 'article';
}

const { title, description, ogType = 'website' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// Absolute, because every scraper that reads this tag refuses a relative one.
const ogImage = new URL('/og.png', Astro.site);
const nav = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Writing' },
  { href: '/about', label: 'About' },
];

// The notch marks the section you are in, so a case study keeps /projects lit.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Gerald Chang — Writing"
      href="/rss.xml"
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Gerald Chang" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Gerald Chang — developer" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="bg-canvas text-ink antialiased">
    <div class="flex min-h-screen flex-col">
      <header class="bar">
        <div class="mx-auto w-full max-w-page px-gutter sm:px-8">
          <nav class="bar-nav" aria-label="Primary">
            {nav.map((item) => (
              <a
                class="bar-link"
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      </header>

      <main class="mx-auto w-full max-w-page flex-1 px-gutter pt-section pb-block sm:px-8">
        <slot />
      </main>

      <footer class="mt-auto border-t border-rule">
        <div class="mx-auto w-full max-w-page px-gutter py-8 font-mono text-meta sm:px-8">
          <a class="link-quiet" href="https://github.com/GcdZ03">GitHub</a>
        </div>
      </footer>
    </div>
  </body>
</html>
